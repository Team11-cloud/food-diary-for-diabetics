# main_diary.py
import sqlite3
import datetime
from typing import List, Dict, Optional
from models import FoodEntry, BloodSugar
from custom_foods import CustomFoodManager
from constants import food_db

class DiabetesDiary:
    """Основной класс дневника питания для диабетиков"""
    
    def init(self, db_path: str = "diabetes_diary.db"):
        self.db_path = db_path
        self.custom_food_manager = CustomFoodManager(db_path)
        self._init_database()
    
    def _init_database(self):
        """Инициализация базы данных"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # Таблица записей о питании
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS food_entries (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                food_name TEXT NOT NULL,
                carbohydrates REAL NOT NULL,
                protein REAL NOT NULL,
                fat REAL NOT NULL,
                calories INTEGER NOT NULL,
                timestamp DATETIME NOT NULL
            )
        ''')
        
        # Таблица измерений сахара
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS blood_sugar_measurements (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                value REAL NOT NULL,
                timestamp DATETIME NOT NULL,
                measurement_type TEXT NOT NULL
            )
        ''')
        
        # Таблица профилей пользователей
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS user_profiles (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                insulin_carb_ratio REAL DEFAULT 10.0,
                target_sugar_min REAL DEFAULT 4.0,
                target_sugar_max REAL DEFAULT 7.0,
                created_date DATETIME DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        conn.commit()
        conn.close()
    
    def get_food_info(self, food_name: str) -> Optional[Dict]:
        """Получение информации о продукте из всех источников"""
        food_name = food_name.lower()
        
        # Проверяем в основной базе
        if food_name in food_db:
            return food_db[food_name]
        
        # Проверяем в пользовательской базе
        custom_food = self.custom_food_manager.get_custom_food_info(food_name)
        if custom_food:
            return custom_food
        
        return None
    
    def get_combined_food_database(self) -> Dict:
        """Получение объединенной базы данных продуктов"""
        combined_db = food_db.copy()
        custom_foods = self.custom_food_manager.get_all_custom_foods()
        combined_db.update(custom_foods)
        return combined_db

