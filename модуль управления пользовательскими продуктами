# custom_foods.py
import sqlite3
from typing import Dict, Optional

class CustomFoodManager:
    """Класс для управления пользовательскими продуктами"""
    
    def init(self, db_path: str = "diabetes_diary.db"):          __init__
        self.db_path = db_path
        self._init_custom_foods_table()
    
    def _init_custom_foods_table(self):
        """Инициализация таблицы пользовательских продуктов"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS custom_foods (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                food_name TEXT UNIQUE NOT NULL,
                calories REAL NOT NULL,
                protein REAL NOT NULL,
                fat REAL NOT NULL,
                carbs REAL NOT NULL
            )
        ''')
        
        conn.commit()
        conn.close()
    
    def add_custom_food(self, name: str, calories: float, protein: float, 
                       fat: float, carbs: float, food_db: Dict) -> bool:
        """Добавление пользовательского продукта"""
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cursor.execute('''
                INSERT OR REPLACE INTO custom_foods 
                (food_name, calories, protein, fat, carbs)
                VALUES (?, ?, ?, ?, ?)
            ''', (name.lower(), calories, protein, fat, carbs))
            
            conn.commit()
            conn.close()
            
            # Обновляем базу данных в памяти
            food_db[name.lower()] = {
                "calories": calories,
                "protein": protein,
                "fat": fat,
                "carbs": carbs
            }
            
            return True
        except Exception as e:
            print(f"Ошибка при добавлении продукта: {e}")
            return False
    
    def get_custom_food_info(self, food_name: str) -> Optional[Dict]:
        """Получение информации о пользовательском продукте"""
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cursor.execute('''
                SELECT calories, protein, fat, carbs 
                FROM custom_foods 
                WHERE food_name = ?
            ''', (food_name.lower(),))
            
            result = cursor.fetchone()
            conn.close()
            
            if result:
                return {
                    "calories": result[0],
                    "protein": result[1],
                    "fat": result[2],
                    "carbs": result[3]
                }
        except Exception as e:
            print(f"Ошибка при поиске пользовательского продукта: {e}")
        
        return None
    
    def get_all_custom_foods(self) -> Dict[str, Dict]:
        """Получение всех пользовательских продуктов"""
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cursor.execute('SELECT food_name, calories, protein, fat, carbs FROM custom_foods')
            
            custom_foods = {}
            for row in cursor.fetchall():
                custom_foods[row[0]] = {
                    "calories": row[1],
                    "protein": row[2],
                    "fat": row[3],
                    "carbs": row[4]
                }
            
            conn.close()
            return custom_foods
        except Exception as e:
            print(f"Ошибка при получении пользовательских продуктов: {e}")
            return {}
