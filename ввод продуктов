def calculate_kbju():
    
    while True:
        print("\n" + "-" * 30)
        product = input("Введите продукт (или 'стоп' для выхода): ").lower().strip()
        
        if product == 'стоп':
            break

        try:
            weight = float(input("Вес в граммах: "))       Сделайте обработку весу, он больше 0
        except ValueError:
            print("❌ Ошибка: введите число")
            continue

        coef = weight / 100
        nutrition = food_db[product]
        
        print(f"\n📊 КБЖУ для {product} ({weight}г):")
        print(f"🔥 Калории: {nutrition['calories'] * coef:.1f} ккал")
        print(f"💪 Белки: {nutrition['protein'] * coef:.1f} г")
        print(f"🥑 Жиры: {nutrition['fat'] * coef:.1f} г")
        print(f"🍚 Углеводы: {nutrition['carbs'] * coef:.1f} г")

